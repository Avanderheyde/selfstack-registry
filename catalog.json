        "expected_status": 200,
        "interval_seconds": 30,
        "timeout_seconds": 5,
        "start_period_seconds": 15
      },
      "backup": {
        "strategy": "volume-snapshot",
        "pre_backup_cmd": null,
        "post_backup_cmd": null
      },
      "upgrade": {
        "strategy": "pull-and-restart",
