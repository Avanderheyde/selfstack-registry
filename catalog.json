      "container": {
        "image": "twentycrm/twenty:latest",
        "build_from_repo": false,
        "ports": [
          {
            "container_port": 3000,
            "protocol": "http",
            "label": "Web UI",
            "tunnel_expose": true
          }
        ],
        "volumes": [
          {
            "name": "twenty-server-data",
            "container_path": "/app/packages/twenty-server/.local-storage",
            "backup": true,
            "estimated_size_mb": 100
          }
        ],
        "environment": {
          "APP_SECRET": "${APP_SECRET:-replace_me_with_openssl_rand_base64_32}",
          "NODE_PORT": "3000",
          "PG_DATABASE_URL": "postgres://${PG_DATABASE_USER:-postgres}:${PG_DATABASE_PASSWORD:-postgres}@${PG_DATABASE_HOST:-db}:${PG_DATABASE_PORT:-5432}/${PG_DATABASE_NAME:-default}",
          "REDIS_URL": "${REDIS_URL:-redis://redis:6379}",
          "SERVER_URL": "${SERVER_URL:-http://localhost:3000}",
          "STORAGE_TYPE": "${STORAGE_TYPE:-local}"
        },
        "depends_on": [
          "db",
          "redis"
        ]
      },
      "sidecars": [
        {
          "name": "db",
