          {
            "container_port": 5006,
            "protocol": "http",
            "label": "Web UI",
            "tunnel_expose": true
          }
        ],
        "volumes": [
          {
            "name": "actual-data",
            "container_path": "/data",
            "backup": true,
            "estimated_size_mb": 100
          }
        ],
        "environment": {},
        "depends_on": []
      },
      "resources": {
        "memory_min_mb": 128,
        "memory_recommended_mb": 256,
        "cpu_shares": 256,
        "disk_min_gb": 1
      },
      "health": {
        "endpoint": "/",
